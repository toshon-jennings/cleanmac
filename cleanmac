#!/bin/bash
# cleanmac v1.2.0 - A script to clean developer caches and system junk on macOS

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# --- Flags ---
DRY_RUN=false
SILENT=false
ONLY=""
SKIP=""
AGGRESSIVE=false
CACHE=false
AI=false

# --- Parse arguments ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run|-n)
            DRY_RUN=true
            shift
            ;;
        --silent|-y)
            SILENT=true
            shift
            ;;
        --only)
            ONLY="$2"
            shift 2
            ;;
        --skip)
            SKIP="$2"
            shift 2
            ;;
        --aggressive|-a)
            AGGRESSIVE=true
            shift
            ;;
        --cache|-c)
            CACHE=true
            shift
            ;;
        --ai)
            AI=true
            shift
            ;;
        --standard|-s)
            AGGRESSIVE=false
            shift
            ;;
        --help|-h)
            echo "cleanmac v1.2.0 — macOS developer cache cleanup"
            echo ""
            echo "Usage: cleanmac [OPTIONS]"
            echo ""
            echo "Modes:"
            echo "  (default)          Standard — developer caches only (uv, pip, npm, bun, brew, xcode, cargo, docker)"
            echo "  --aggressive, -a   Deep clean — app caches, logs, orphaned data, old installers, code signing clones"
            echo "  --cache, -c        Clean ~/.cache/ directory (puppeteer, playwright, codex, whisper, etc.)"
            echo "  --ai               Clean AI/ML model caches (huggingface, ollama, torch, conda, etc.)"
            echo "  --standard, -s     Explicit standard mode (same as default)"
            echo ""
            echo "Options:"
            echo "  --dry-run, -n     Show what would be deleted without deleting"
            echo "  --silent, -y      Suppress verbose output (cron-friendly)"
            echo "  --only <targets>  Comma-separated list of targets to clean (e.g., docker,npm)"
            echo "  --skip <targets>  Comma-separated list of targets to skip (e.g., xcode,cargo)"
            echo "  --help, -h        Show this help message"
            echo ""
            echo "Standard targets: uv, pip, npm, bun, brew, xcode, cargo, docker"
            echo "Aggressive targets: apps, logs, orphaned, downloads, code-signing, simulators, xcode-archives, gradle, pip-cache"
            echo "Cache targets: puppeteer, playwright, codex, whisper, chroma, prisma, go-build, electron, pnpm"
            echo "AI targets: huggingface, ollama, torch, conda, pyenv"
            echo ""
            echo "Environment variables:"
            echo "  CARGO_HOME         (default: ~/.cargo)"
            echo "  NPM_CONFIG_CACHE   (default: ~/.npm)"
            echo "  DOCKER_CONFIG      (default: ~/.docker)"
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            echo "Run 'cleanmac --help' for usage."
            exit 1
            ;;
    esac
done

# --- Helper: check if a target is enabled ---
is_enabled() {
    local target="$1"

    if [[ -n "$SKIP" ]]; then
        if echo ",$SKIP," | grep -qi ",$target,"; then
            return 1
        fi
    fi

    if [[ -n "$ONLY" ]]; then
        if ! echo ",$ONLY," | grep -qi ",$target,"; then
            return 1
        fi
    fi

    return 0
}

# --- Helper: get directory size ---
get_size() {
    local path="$1"
    if [[ -d "$path" ]]; then
        du -sh "$path" 2>/dev/null | cut -f1 || echo "0B"
    else
        echo "0B"
    fi
}

# --- Helper: get size in bytes (for summing) ---
get_size_bytes() {
    local path="$1"
    if [[ -d "$path" ]]; then
        du -sk "$path" 2>/dev/null | cut -f1 || echo "0"
    else
        echo "0"
    fi
}

# --- Helper: format kilobytes to human-readable ---
humanize() {
    local kb=$1
    if [[ $kb -ge 1048576 ]]; then
        echo "$(awk -v k="$kb" 'BEGIN {printf "%.1f", k/1048576}') GB"
    elif [[ $kb -ge 1024 ]]; then
        echo "$(awk -v k="$kb" 'BEGIN {printf "%.1f", k/1024}') MB"
    else
        echo "${kb} KB"
    fi
}

# --- Helper: safely remove a path ---
safe_rm() {
    local path="$1"
    local description="$2"

    if [[ "$DRY_RUN" == true ]]; then
        echo -e "  ${YELLOW}[would delete]${NC} $description"
    else
        rm -rf "$path" 2>/dev/null && \
            echo -e "  ${GREEN}[deleted]${NC} $description" || \
            echo -e "  ${YELLOW}[skipped]${NC} $description (permission denied)"
    fi
}

# --- Helper: check if an app is installed ---
app_installed() {
    local app_name="$1"
    ls "/Applications/${app_name}.app" &>/dev/null || \
    ls "$HOME/Applications/${app_name}.app" &>/dev/null
}

# --- Helper: confirm before destructive action ---
confirm() {
    local message="$1"
    if [[ "$SILENT" == true ]]; then
        return 0
    fi
    echo -e "${YELLOW}$message [y/N]${NC}"
    read -r response
    [[ "$response" =~ ^[Yy]$ ]]
}

# --- Print header ---
if [[ "$SILENT" == false ]]; then
    echo -e "${BLUE}=== Starting macOS Developer Cache Cleanup ===${NC}"
    if [[ "$DRY_RUN" == true ]]; then
        echo -e "${YELLOW}--- DRY RUN (no files will be deleted) ---${NC}"
    fi
    if [[ "$AGGRESSIVE" == true ]]; then
        echo -e "${YELLOW}--- AGGRESSIVE MODE (cleaning app caches and logs) ---${NC}"
    fi
    echo ""
fi

# --- Accumulators for savings summary ---
TOTAL_SAVED_KB=0
declare -a SAVINGS_LINES=()

# --- 1. Clean uv cache ---
if is_enabled "uv"; then
    if command -v uv &> /dev/null; then
        cache_path="$HOME/.cache/uv"
        size_bytes=$(get_size_bytes "$cache_path")
        size_human=$(get_size "$cache_path")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("uv        $size_human (dry run)")
        else
            if [[ "$SILENT" == false ]]; then
                echo -e "${GREEN}[uv]${NC} Cleaning uv cache (was $size_human)..."
            fi
            uv cache clean --force &>/dev/null
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    fi
fi

# --- 2. Clean pip cache ---
if is_enabled "pip"; then
    pip_cache="$HOME/Library/Caches/pip"
    if [[ -d "$pip_cache" ]]; then
        size_bytes=$(get_size_bytes "$pip_cache")
        size_human=$(get_size "$pip_cache")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("pip       $size_human (dry run)")
        else
            if [[ "$SILENT" == false ]]; then
                echo -e "${GREEN}[pip]${NC} Cleaning pip cache (was $size_human)..."
            fi
            rm -rf "$pip_cache"/*
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    fi
fi

# --- 3. Clean npm cache ---
if is_enabled "npm"; then
    if command -v npm &> /dev/null; then
        npm_cache="${NPM_CONFIG_CACHE:-$HOME/.npm}"
        size_bytes=$(get_size_bytes "$npm_cache")
        size_human=$(get_size "$npm_cache")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("npm       $size_human (dry run)")
        else
            if [[ "$SILENT" == false ]]; then
                echo -e "${GREEN}[npm]${NC} Cleaning npm cache (was $size_human)..."
            fi
            npm cache clean --force &>/dev/null
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    fi
fi

# --- 4. Clean bun cache ---
if is_enabled "bun"; then
    if command -v bun &> /dev/null; then
        bun_cache="$HOME/.bun"
        size_bytes=$(get_size_bytes "$bun_cache")
        size_human=$(get_size "$bun_cache")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("bun       $size_human (dry run)")
        else
            if [[ "$SILENT" == false ]]; then
                echo -e "${GREEN}[bun]${NC} Cleaning bun cache (was $size_human)..."
            fi
            bun pm cache clean &>/dev/null
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    fi
fi

# --- 5. Clean Homebrew cache ---
if is_enabled "brew"; then
    if command -v brew &> /dev/null; then
        brew_cache="$(brew --cache 2>/dev/null || echo "$HOME/Library/Caches/Homebrew")"
        size_bytes=$(get_size_bytes "$brew_cache")
        size_human=$(get_size "$brew_cache")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("brew      $size_human (dry run)")
        else
            if [[ "$SILENT" == false ]]; then
                echo -e "${GREEN}[brew]${NC} Running brew cleanup..."
            fi
            brew cleanup -s &>/dev/null
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    fi
fi

# --- 6. Clean Xcode DerivedData ---
if is_enabled "xcode"; then
    derived_data="$HOME/Library/Developer/Xcode/DerivedData"
    if [[ -d "$derived_data" ]]; then
        size_bytes=$(get_size_bytes "$derived_data")
        size_human=$(get_size "$derived_data")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("xcode     $size_human (dry run)")
        else
            if [[ "$SILENT" == false ]]; then
                echo -e "${GREEN}[xcode]${NC} Cleaning Xcode DerivedData (was $size_human)..."
            fi
            rm -rf "$derived_data"/*
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    fi
fi

# --- 7. Clean Cargo global cache ---
if is_enabled "cargo"; then
    if command -v cargo &> /dev/null; then
        cargo_home="${CARGO_HOME:-$HOME/.cargo}"
        size_bytes=$(get_size_bytes "$cargo_home")
        size_human=$(get_size "$cargo_home")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("cargo     $size_human (dry run)")
        else
            if cargo cache --version &>/dev/null; then
                if [[ "$SILENT" == false ]]; then
                    echo -e "${GREEN}[cargo]${NC} Running cargo cache autoclean..."
                fi
                cargo cache -a &>/dev/null
            else
                if [[ "$SILENT" == false ]]; then
                    echo -e "${YELLOW}[cargo]${NC} Skipping (cargo-cache not installed)"
                fi
            fi
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    fi
fi

# --- 8. Clean Docker ---
if is_enabled "docker"; then
    if command -v docker &> /dev/null && docker info &> /dev/null; then
        docker_buildx="$HOME/.docker/buildx"
        size_bytes=$(get_size_bytes "$docker_buildx")
        size_human=$(get_size "$docker_buildx")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("docker    $size_human (dry run)")
        else
            if [[ "$SILENT" == false ]]; then
                echo -e "${GREEN}[docker]${NC} Pruning unused Docker resources..."
            fi
            docker system prune -f --volumes &>/dev/null
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    fi
fi

# --- AGGRESSIVE MODE TARGETS ---

# --- 9. Clean app caches ---
if [[ "$AGGRESSIVE" == true ]] && is_enabled "apps"; then
    if [[ "$SILENT" == false ]]; then
        echo -e "${GREEN}[apps]${NC} Cleaning application caches..."
    fi

    # Known safe cache subdirectories (never delete the whole App Support folder)
    CACHE_SUBDIRS=("Cache" "Code Cache" "GPUCache" "Crashpad" "CachedData" "CachedExtensionVSIXs" "WebStorage" "CachedProfilesData" "DawnWebGPUCache" "DawnGraphiteCache" "logs" "ShipIt")

    for app_dir in "$HOME/Library/Application Support"/*/; do
        app_name=$(basename "$app_dir")

        # Skip Chrome profiles — contains passwords, bookmarks, history
        if [[ "$app_name" == "Google" ]] || [[ "$app_name" == "GoogleChrome" ]]; then
            continue
        fi

        # Skip browsers with sensitive profile data
        if [[ "$app_name" == "Mozilla" ]] || [[ "$app_name" == "BraveSoftware" ]]; then
            continue
        fi

        for subdir in "${CACHE_SUBDIRS[@]}"; do
            target="$app_dir$subdir"
            if [[ -d "$target" ]]; then
                size_bytes=$(get_size_bytes "$target")
                size_human=$(get_size "$target")

                if [[ "$DRY_RUN" == true ]]; then
                    SAVINGS_LINES+=("apps:$app_name/$subdir  $size_human (dry run)")
                else
                    safe_rm "$target" "$app_name/$subdir ($size_human)"
                fi
                TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
            fi
        done
    done

    # Clean ~/Library/Caches/* (system-designated volatile folder)
    for cache_dir in "$HOME/Library/Caches"/*/; do
        [[ -d "$cache_dir" ]] || continue
        app_name=$(basename "$cache_dir")

        # Skip Chrome cache
        if [[ "$app_name" == "Google" ]]; then
            continue
        fi

        # Skip system caches (com.apple.*, CloudKit, mds, etc.)
        if [[ "$app_name" == com.apple.* ]] || [[ "$app_name" == "CloudKit" ]] || [[ "$app_name" == "mds" ]] || [[ "$app_name" == "mds_stores" ]]; then
            continue
        fi

        size_bytes=$(get_size_bytes "$cache_dir")
        size_human=$(get_size "$cache_dir")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("cache:$app_name  $size_human (dry run)")
        else
            safe_rm "$cache_dir" "Caches/$app_name ($size_human)"
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    done
fi

# --- 10. Clean log files ---
if [[ "$AGGRESSIVE" == true ]] && is_enabled "logs"; then
    if [[ "$SILENT" == false ]]; then
        echo -e "${GREEN}[logs]${NC} Cleaning log files..."
    fi

    # ~/Library/Logs
    if [[ -d "$HOME/Library/Logs" ]]; then
        for log_dir in "$HOME/Library/Logs"/*/; do
            size_bytes=$(get_size_bytes "$log_dir")
            size_human=$(get_size "$log_dir")

            if [[ "$DRY_RUN" == true ]]; then
                SAVINGS_LINES+=("logs:$(basename "$log_dir")  $size_human (dry run)")
            else
                safe_rm "$log_dir" "Logs/$(basename "$log_dir") ($size_human)"
            fi
            TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
        done
    fi

    # Crashpad folders in App Support
    while IFS= read -r crashpad; do
        [[ -z "$crashpad" ]] && continue
        size_bytes=$(get_size_bytes "$crashpad")
        size_human=$(get_size "$crashpad")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("crashpad  $size_human (dry run)")
        else
            safe_rm "$crashpad" "Crashpad ($size_human)"
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    done < <(find "$HOME/Library/Application Support" -maxdepth 2 -name "Crashpad" -type d 2>/dev/null || true)
fi

# --- 11. Clean orphaned app data ---
if [[ "$AGGRESSIVE" == true ]] && is_enabled "orphaned"; then
    if [[ "$SILENT" == false ]]; then
        echo -e "${GREEN}[orphaned]${NC} Checking for orphaned app data..."
    fi

    # Docker Desktop leftovers (only if Docker Desktop app is not installed)
    if ! app_installed "Docker"; then
        docker_leftover="$HOME/Library/Containers/com.docker.docker"
        if [[ -d "$docker_leftover" ]]; then
            size_bytes=$(get_size_bytes "$docker_leftover")
            size_human=$(get_size "$docker_leftover")

            if [[ "$DRY_RUN" == true ]]; then
                SAVINGS_LINES+=("orphaned:docker-desktop  $size_human (dry run)")
            else
                safe_rm "$docker_leftover" "Docker Desktop leftovers ($size_human)"
            fi
            TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
        fi

        docker_config="$HOME/.docker"
        if [[ -d "$docker_config" ]]; then
            size_bytes=$(get_size_bytes "$docker_config")
            size_human=$(get_size "$docker_config")

            if [[ "$DRY_RUN" == true ]]; then
                SAVINGS_LINES+=("orphaned:.docker  $size_human (dry run)")
            else
                safe_rm "$docker_config" "Docker config ($size_human)"
            fi
            TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
        fi
    fi

    # Check for App Support folders where the app is no longer installed
    for app_dir in "$HOME/Library/Application Support"/*/; do
        [[ -d "$app_dir" ]] || continue
        app_name=$(basename "$app_dir")

        # Skip known multi-app suites and system folders
        if [[ "$app_name" == "Google" ]] || [[ "$app_name" == "Mozilla" ]] || [[ "$app_name" == "com.apple" ]]; then
            continue
        fi

        # Skip reverse-domain named folders (com.*, org.*, etc.) — these are usually
        # subdirectories of installed apps, not standalone apps
        if [[ "$app_name" == com.* ]] || [[ "$app_name" == org.* ]] || [[ "$app_name" == net.* ]] || [[ "$app_name" == io.* ]]; then
            continue
        fi

        # Check if any matching app exists (try exact match and partial match)
        if ! ls "/Applications/${app_name}.app" &>/dev/null && \
           ! ls "$HOME/Applications/${app_name}.app" &>/dev/null && \
           ! find /Applications ~/Applications -maxdepth 1 -name "*${app_name}*" -name "*.app" -print -quit 2>/dev/null | grep -q .; then
            size_bytes=$(get_size_bytes "$app_dir")
            size_human=$(get_size "$app_dir")

            # Only flag if > 100MB to avoid noise
            if [[ $size_bytes -gt 102400 ]]; then
                if [[ "$DRY_RUN" == true ]]; then
                    SAVINGS_LINES+=("orphaned:$app_name  $size_human (dry run)")
                else
                    if confirm "App '$app_name' appears uninstalled. Delete its data ($size_human)?"; then
                        safe_rm "$app_dir" "Orphaned: $app_name ($size_human)"
                        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
                    fi
                fi
            fi
        fi
    done
fi

# --- 12. Clean old Downloads ---
if [[ "$AGGRESSIVE" == true ]] && is_enabled "downloads"; then
    if [[ "$SILENT" == false ]]; then
        echo -e "${GREEN}[downloads]${NC} Checking for old installers in Downloads..."
    fi

    # Find DMG/ZIP files older than 30 days in Downloads
    while IFS= read -r installer; do
        [[ -z "$installer" ]] && continue
        # Skip if file is newer than 30 days
        if [[ -n $(find "$installer" -mtime -30 2>/dev/null) ]]; then
            continue
        fi

        size_bytes=$(du -sk "$installer" 2>/dev/null | cut -f1)
        size_human=$(du -sh "$installer" 2>/dev/null | cut -f1)

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("downloads:$(basename "$installer")  $size_human (dry run)")
        else
            safe_rm "$installer" "Old installer: $(basename "$installer") ($size_human)"
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    done < <(find "$HOME/Downloads" -maxdepth 2 \( -name "*.dmg" -o -name "*.zip" -o -name "*.pkg" \) -mtime +30 2>/dev/null || true)
fi

# --- 13. Clean code signing clones ---
if [[ "$AGGRESSIVE" == true ]] && is_enabled "code-signing"; then
    if [[ "$SILENT" == false ]]; then
        echo -e "${GREEN}[code-signing]${NC} Cleaning orphaned code signing clones..."
    fi

    # Find code_sign_clone directories in temp folders
    while IFS= read -r clone; do
        [[ -z "$clone" ]] && continue
        size_bytes=$(get_size_bytes "$clone")
        size_human=$(get_size "$clone")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("code-signing  $size_human (dry run)")
        else
            safe_rm "$clone" "Code signing clone ($size_human)"
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    done < <(find /private/var/folders -maxdepth 4 -type d -name "*.code_sign_clone" 2>/dev/null || true)
fi

# --- 14. Clean Xcode archives ---
if [[ "$AGGRESSIVE" == true ]] && is_enabled "xcode-archives"; then
    archives_dir="$HOME/Library/Developer/Xcode/Archives"
    if [[ -d "$archives_dir" ]]; then
        size_bytes=$(get_size_bytes "$archives_dir")
        size_human=$(get_size "$archives_dir")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("xcode-archives  $size_human (dry run)")
        else
            if [[ "$SILENT" == false ]]; then
                echo -e "${GREEN}[xcode-archives]${NC} Cleaning Xcode archives (was $size_human)..."
            fi
            safe_rm "$archives_dir" "Xcode Archives ($size_human)"
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    fi
fi

# --- 15. Clean iOS/watchOS device support ---
if [[ "$AGGRESSIVE" == true ]] && is_enabled "simulators"; then
    if [[ "$SILENT" == false ]]; then
        echo -e "${GREEN}[simulators]${NC} Cleaning simulator and device support data..."
    fi

    # CoreSimulator
    simulator_dir="$HOME/Library/Developer/CoreSimulator"
    if [[ -d "$simulator_dir" ]]; then
        size_bytes=$(get_size_bytes "$simulator_dir")
        size_human=$(get_size "$simulator_dir")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("simulators:CoreSimulator  $size_human (dry run)")
        else
            safe_rm "$simulator_dir" "CoreSimulator ($size_human)"
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    fi

    # iOS DeviceSupport
    device_support_dir="$HOME/Library/Developer/Xcode/iOS DeviceSupport"
    if [[ -d "$device_support_dir" ]]; then
        size_bytes=$(get_size_bytes "$device_support_dir")
        size_human=$(get_size "$device_support_dir")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("simulators:iOS-DeviceSupport  $size_human (dry run)")
        else
            safe_rm "$device_support_dir" "iOS DeviceSupport ($size_human)"
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    fi
fi

# --- 16. Clean Gradle cache ---
if [[ "$AGGRESSIVE" == true ]] && is_enabled "gradle"; then
    gradle_cache="$HOME/.gradle/caches"
    if [[ -d "$gradle_cache" ]]; then
        size_bytes=$(get_size_bytes "$gradle_cache")
        size_human=$(get_size "$gradle_cache")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("gradle  $size_human (dry run)")
        else
            if [[ "$SILENT" == false ]]; then
                echo -e "${GREEN}[gradle]${NC} Cleaning Gradle cache (was $size_human)..."
            fi
            safe_rm "$gradle_cache" "Gradle caches ($size_human)"
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    fi
fi

# --- 17. Clean pip cache (modern location) ---
if [[ "$AGGRESSIVE" == true ]] && is_enabled "pip-cache"; then
    pip_cache_modern="$HOME/.cache/pip"
    if [[ -d "$pip_cache_modern" ]]; then
        size_bytes=$(get_size_bytes "$pip_cache_modern")
        size_human=$(get_size "$pip_cache_modern")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("pip-cache  $size_human (dry run)")
        else
            if [[ "$SILENT" == false ]]; then
                echo -e "${GREEN}[pip-cache]${NC} Cleaning pip cache (~/.cache/pip, was $size_human)..."
            fi
            safe_rm "$pip_cache_modern" "pip cache (~/.cache/pip, $size_human)"
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    fi
fi

# --- CACHE MODE TARGETS ---

# --- 18. Clean ~/.cache/ directory ---
if [[ "$CACHE" == true ]] && is_enabled "cache"; then
    if [[ "$SILENT" == false ]]; then
        echo -e "${GREEN}[cache]${NC} Cleaning ~/.cache/ directory..."
    fi

    # Directories to clean in ~/.cache/
    CACHE_DIRS=(
        "puppeteer"
        "codex-runtimes"
        "chroma"
        "whisper-models"
        "openwhispr"
        "time-globe"
        "prisma"
        "fontconfig"
        "node"
        "opencode"
        "codebase-memory-mcp"
        "outlines"
        "vscode-ripgrep"
        "gh"
        "chrome-devtools-mcp"
        "claude"
        "antigravity"
    )

    for cache_dir_name in "${CACHE_DIRS[@]}"; do
        target="$HOME/.cache/$cache_dir_name"
        if [[ -d "$target" ]]; then
            size_bytes=$(get_size_bytes "$target")
            size_human=$(get_size "$target")

            if [[ "$DRY_RUN" == true ]]; then
                SAVINGS_LINES+=("cache:$cache_dir_name  $size_human (dry run)")
            else
                safe_rm "$target" "~/.cache/$cache_dir_name ($size_human)"
            fi
            TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
        fi
    done

    # Also clean go-build cache
    go_build_cache="$HOME/.cache/go-build"
    if [[ -d "$go_build_cache" ]]; then
        size_bytes=$(get_size_bytes "$go_build_cache")
        size_human=$(get_size "$go_build_cache")

        if [[ "$DRY_RUN" == true ]]; then
            SAVINGS_LINES+=("cache:go-build  $size_human (dry run)")
        else
            if command -v go &> /dev/null; then
                go clean -cache &>/dev/null
                echo -e "  ${GREEN}[deleted]${NC} ~/.cache/go-build ($size_human)"
            else
                safe_rm "$go_build_cache" "~/.cache/go-build ($size_human)"
            fi
        fi
        TOTAL_SAVED_KB=$((TOTAL_SAVED_KB + size_bytes))
    fi
fi

